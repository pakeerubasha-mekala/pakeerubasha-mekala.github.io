---
import { profile } from '../data/profile';
const stages = ['git push', 'build', 'test', 'scan', 'deploy', 'live'];
const x = (i: number) => 50 + i * 130;
---

<div class="pipe fx" aria-hidden="true">
  <p class="cmd"><span>$</span> ./pipeline.sh --env prod</p>
  <svg viewBox="0 0 750 90" role="img" aria-label="Animated CI/CD pipeline: git push, build, test, scan, deploy, live">
    <line class="track" x1={x(0)} y1="34" x2={x(5)} y2="34" />
    <line class="flow" x1={x(0)} y1="34" x2={x(5)} y2="34" />
    <circle class="packet" r="5" cx="0" cy="0" />
    {stages.map((label, i) => (
      <g class="stage" style={`--i:${i}`}>
        <circle cx={x(i)} cy="34" r="13" />
        <text class="tick" x={x(i)} y="39" text-anchor="middle">✓</text>
        <text class="lbl" x={x(i)} y="72" text-anchor="middle">{label}</text>
      </g>
    ))}
  </svg>
  <p class="live" id="live-deploy" data-repo={profile.repo} hidden></p>
</div>

<script>
  import { getDeploy } from '../utils/liveStatus';

  async function initLive() {
    const line = document.getElementById('live-deploy');
    const repo = line?.dataset.repo;
    if (!line || !repo) return;
    const info = await getDeploy(repo);
    if (!info) return;

    const label = info.state === 'success' ? 'success' : info.state === 'failure' ? 'failed' : 'unknown';
    line.textContent = '';
    const dot = document.createElement('i');
    dot.className = info.state;
    line.append(dot, `live from GitHub Actions: last deploy ${label} ${info.ago} (${info.sha})`);
    line.hidden = false;

    // Matching real row in the skills table.
    const row = document.getElementById('pod-live');
    if (row) {
      row.querySelector('.state')!.textContent = label === 'success' ? 'Succeeded' : label === 'failed' ? 'Failed' : 'Unknown';
      row.querySelector('.tools')!.textContent = `GitHub Actions · ${info.sha} · ${info.ago} · live from api.github.com`;
      row.classList.add(info.state);
      row.hidden = false;
    }
  }

  initLive();
</script>

<style>
  .pipe {
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-2) 0.4rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cmd {
    margin: 0 0 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .cmd span {
    color: var(--accent);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
  }

  .live {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    margin: 0.2rem 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .live[hidden] { display: none; }

  .live :global(i) {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--fg-dim);
  }

  .live :global(i.success) { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .live :global(i.failure) { background: #ff5f56; box-shadow: 0 0 8px #ff5f56; }

  .track {
    stroke: var(--border);
    stroke-width: 3;
  }

  .flow {
    stroke: var(--accent);
    stroke-width: 3;
    stroke-dasharray: 8 10;
    animation: flow 1.2s linear infinite;
    opacity: 0.55;
  }

  @keyframes flow {
    to { stroke-dashoffset: -18; }
  }

  .packet {
    fill: var(--accent);
    filter: drop-shadow(0 0 6px var(--accent));
    offset-path: path('M50 34 L700 34');
    animation: travel 4.8s linear infinite;
  }

  @keyframes travel {
    from { offset-distance: 0%; }
    to { offset-distance: 100%; }
  }

  .stage circle {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 2;
    animation: stage 4.8s linear infinite;
    animation-delay: calc(var(--i) * 0.96s);
  }

  .tick {
    fill: var(--accent);
    font-size: 13px;
    font-weight: 700;
    opacity: 0;
    animation: tick 4.8s linear infinite;
    animation-delay: calc(var(--i) * 0.96s);
  }

  .lbl {
    fill: var(--fg-dim);
    font-size: 12px;
  }

  /* Each stage lights up as the packet passes it (packet takes 4.8s end to end, 0.96s per stage). */
  @keyframes stage {
    0%, 22% { stroke: var(--accent); fill: var(--glow); }
    32%, 100% { stroke: var(--border); fill: var(--bg); }
  }

  @keyframes tick {
    0%, 22% { opacity: 1; }
    32%, 100% { opacity: 0; }
  }
</style>
