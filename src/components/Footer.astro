---
import { profile } from '../data/profile';
import GitGraph from './art/GitGraph.astro';

const year = new Date().getFullYear();
const repoUrl = `https://github.com/${profile.repo}`;

const groups = [
  {
    title: 'connect',
    links: [
      profile.email && { label: 'email', href: `mailto:${profile.email}` },
      { label: 'linkedin', href: profile.links.linkedin },
      profile.links.github && { label: 'github', href: profile.links.github },
      profile.links.stackoverflow && { label: 'stack overflow', href: profile.links.stackoverflow },
    ],
  },
  {
    title: 'more',
    links: [
      { label: 'status', href: '/status' },
      { label: 'changelog', href: '/changelog' },
      { label: 'now', href: '/now' },
      { label: "how it's built", href: '/how-its-built' },
      { label: 'rss feed', href: '/rss.xml' },
      { label: 'source code', href: repoUrl },
    ],
  },
].map((g) => ({ ...g, links: g.links.filter(Boolean) as { label: string; href: string }[] }));
---

<footer class="site-footer">
  <div class="footer-art fx" aria-hidden="true"><GitGraph /></div>
  <div class="cols">
    {groups.map((g) => (
      <nav aria-label={g.title}>
        <p class="group-title">{g.title}</p>
        <ul>
          {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <p class="copyright">© {year} {profile.name} · <span id="uptime" class="fx"></span></p>
  <p class="eco" aria-label="Site footprint">
    <span class="eco-seg">⚡ $0/mo</span>
    <span class="eco-seg">static + global CDN</span>
    <span class="eco-seg">~0.09 g CO₂/view</span>
    <span class="eco-seg">green hosting</span>
  </p>
</footer>

<script>
  const el = document.getElementById('uptime');
  if (el) {
    const start = new Date(2016, 10, 1);
    const now = new Date();
    const months = (now.getFullYear() - start.getFullYear()) * 12 + now.getMonth() - start.getMonth();
    el.textContent = `uptime: ${Math.floor(months / 12)}y ${months % 12}m in production`;
  }
</script>

<style>
  .site-footer {
    max-width: var(--measure);
    margin: var(--space-4) auto 0;
    padding: var(--space-3) var(--space-2) var(--space-2);
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--fg-dim);
  }

  .footer-art {
    margin: calc(var(--space-3) * -1) 0 var(--space-3);
    opacity: 0.55;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3);
  }

  .group-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin: 0 0 0.3rem;
  }

  a {
    color: var(--fg-dim);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .copyright {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .eco {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.7rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .eco-seg {
    padding: 0.16em 0.65em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--fg-dim);
  }

  .eco-seg:first-child {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
</style>
