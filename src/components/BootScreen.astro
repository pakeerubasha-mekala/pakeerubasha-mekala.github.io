---
import { profile } from '../data/profile';
---

<div id="boot" class="boot" aria-hidden="true">
  <pre id="boot-log"></pre>
  <p class="skip">press any key or click to skip</p>
  <script id="boot-data" type="application/json" is:inline set:html={JSON.stringify({ name: profile.name }).replace(/</g, '\\u003c')} />
</div>

<script>
  function initBoot() {
    const root = document.documentElement;
    const boot = document.getElementById('boot');
    const log = document.getElementById('boot-log');
    const name = JSON.parse(document.getElementById('boot-data')?.textContent ?? '{}').name ?? 'visitor';

    const finish = () => {
      try { sessionStorage.setItem('booted', '1'); } catch {}
      root.classList.remove('booting');
      boot?.remove();
    };

    if (!boot || !log || !root.classList.contains('booting')) { boot?.remove(); return; }

    const lines = [
      'BIOS: POST ........................ ok',
      'Booting pakeeru-os 6.9.0-devops ...',
      '[  OK  ] Mounted /home/pakeeru',
      '[  OK  ] Started containerd.service',
      '[  OK  ] Started kubelet.service',
      '[  OK  ] Reached target Terraform Applied',
      '[  OK  ] Synced ArgoCD applications',
      '[  OK  ] Started prometheus + grafana',
      '[  OK  ] Pipeline green, 0 failures',
      `Welcome, visitor. Loading ${name} ...`,
    ];

    let i = 0;
    let done = false;
    const stop = () => { if (!done) { done = true; clearInterval(timer); finish(); } };
    const timer = window.setInterval(() => {
      log.textContent += (i ? '\n' : '') + lines[i];
      i += 1;
      if (i >= lines.length) { clearInterval(timer); window.setTimeout(stop, 350); }
    }, 130);

    window.addEventListener('keydown', stop, { once: true });
    boot.addEventListener('click', stop, { once: true });
    window.setTimeout(stop, 5000); // safety net
  }

  initBoot();
</script>

<style>
  .boot {
    display: none;
  }

  :global(html.booting) .boot {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    padding: 2rem;
    background: #03060a;
    color: #36f2a0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    overflow: hidden;
    cursor: pointer;
  }

  pre {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    white-space: pre-wrap;
  }

  .skip {
    position: absolute;
    right: 1.5rem;
    bottom: 1.2rem;
    margin: 0;
    font-size: 0.75rem;
    color: #3b6b50;
  }
</style>
