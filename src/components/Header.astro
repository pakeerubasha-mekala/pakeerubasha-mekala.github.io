---
const nav = [
  { href: '/', label: 'about' },
  { href: '/#experience', label: 'experience' },
  { href: '/work', label: 'work' },
  { href: '/blog', label: 'blog' },
  { href: '/resume', label: 'resume' },
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">
      <span class="prompt">~</span>/pakeeru-basha-mekala<span class="cursor" aria-hidden="true">_</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <button type="button" class="tool" data-open-palette>
        <kbd id="kbd-hint">Ctrl K</kbd><span class="visually-hidden"> open command palette</span>
      </button>
      <button type="button" class="tool" id="scheme-toggle" aria-label="Switch between light and dark theme" title="Switch between light and dark theme">
        <span id="scheme-icon">◐</span>
      </button>
      <button type="button" class="tool" id="mode-toggle" aria-pressed="false" title="Switch between the hacker look and a clean look">
        <span id="mode-label">recruiter mode</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { startMatrix } from '../utils/matrix';
  import { effectiveScheme, toggleScheme } from '../utils/theme';

  const root = document.documentElement;
  const toggle = document.getElementById('mode-toggle');
  const label = document.getElementById('mode-label');
  const hint = document.getElementById('kbd-hint');

  if (hint && /Mac|iPhone|iPad/.test(navigator.platform)) hint.textContent = '⌘ K';

  function sync() {
    const clean = root.dataset.mode === 'clean';
    if (label) label.textContent = clean ? 'hacker mode' : 'recruiter mode';
    toggle?.setAttribute('aria-pressed', String(clean));
  }

  toggle?.addEventListener('click', () => {
    const clean = root.dataset.mode !== 'clean';
    if (clean) root.dataset.mode = 'clean';
    else delete root.dataset.mode;
    root.classList.remove('booting');
    try { localStorage.setItem('mode', clean ? 'clean' : 'hacker'); } catch {}
    sync();
  });

  sync();

  const schemeBtn = document.getElementById('scheme-toggle');
  const schemeIcon = document.getElementById('scheme-icon');
  function syncScheme() {
    if (schemeIcon) schemeIcon.textContent = effectiveScheme() === 'dark' ? '☾' : '☀';
  }
  schemeBtn?.addEventListener('click', () => { toggleScheme(); syncScheme(); });
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', syncScheme);
  syncScheme();

  // Konami code: up up down down left right left right b a
  const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let pos = 0;
  document.addEventListener('keydown', (e) => {
    pos = e.key === code[pos] ? pos + 1 : e.key === code[0] ? 1 : 0;
    if (pos === code.length) { pos = 0; startMatrix(); }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    max-width: calc(var(--measure) + 10rem);
    margin: 0 auto;
    padding: 0.8rem var(--space-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
  }

  .brand .prompt {
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  nav li {
    margin: 0;
  }

  nav a {
    color: var(--fg-dim);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .tools {
    display: flex;
    gap: 0.5rem;
  }

  .tool {
    padding: 0.2em 0.7em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .tool:hover,
  .tool:focus-visible {
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  .tool kbd {
    font-family: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }
</style>
