---
const nav = [
  { href: '/', label: 'about' },
  { href: '/#experience', label: 'experience' },
  { href: '/work', label: 'work' },
  { href: '/blog', label: 'blog' },
  { href: '/resume', label: 'resume' },
];
---

<header class="site-header">
  <div class="inner">
    <div class="left">
      <a class="brand" href="/" aria-label="Pakeeru Basha Mekala — home">
        <svg class="logo" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
          <defs>
            <linearGradient id="pb-logo" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--accent)" />
              <stop offset="1" stop-color="var(--accent-2)" />
            </linearGradient>
          </defs>
          <circle cx="20" cy="20" r="18" fill="url(#pb-logo)" />
          <text x="20" y="26" text-anchor="middle" font-family="var(--font-sans)" font-weight="700" font-size="16.5" letter-spacing="0.3" fill="var(--bg)">PB</text>
        </svg>
      </a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="tools">
      <button type="button" class="tool icon" data-open-palette aria-label="Open command palette" title="Search / command palette">
        <kbd id="kbd-hint">⌘K</kbd>
      </button>
      <button type="button" class="tool icon" id="scheme-toggle" aria-label="Switch between light and dark theme" title="Switch between light and dark theme">
        <span id="scheme-icon">◐</span>
      </button>
      <button type="button" class="tool" id="mode-toggle" aria-pressed="false" title="Switch between the hacker look and a clean look">
        <span id="mode-label">recruiter mode</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { startMatrix } from '../utils/matrix';
  import { effectiveScheme, toggleScheme } from '../utils/theme';

  const root = document.documentElement;
  const toggle = document.getElementById('mode-toggle');
  const label = document.getElementById('mode-label');
  const hint = document.getElementById('kbd-hint');

  if (hint && !/Mac|iPhone|iPad/.test(navigator.platform)) hint.textContent = 'Ctrl K';

  function sync() {
    const clean = root.dataset.mode === 'clean';
    if (label) label.textContent = clean ? 'hacker mode' : 'recruiter mode';
    toggle?.setAttribute('aria-pressed', String(clean));
  }

  toggle?.addEventListener('click', () => {
    const clean = root.dataset.mode !== 'clean';
    if (clean) root.dataset.mode = 'clean';
    else delete root.dataset.mode;
    root.classList.remove('booting');
    try { localStorage.setItem('mode', clean ? 'clean' : 'hacker'); } catch {}
    sync();
  });

  sync();

  const schemeBtn = document.getElementById('scheme-toggle');
  const schemeIcon = document.getElementById('scheme-icon');
  function syncScheme() {
    if (schemeIcon) schemeIcon.textContent = effectiveScheme() === 'dark' ? '☾' : '☀';
  }
  schemeBtn?.addEventListener('click', () => { toggleScheme(); syncScheme(); });
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', syncScheme);
  syncScheme();

  // Konami code: up up down down left right left right b a
  const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let pos = 0;
  document.addEventListener('keydown', (e) => {
    pos = e.key === code[pos] ? pos + 1 : e.key === code[0] ? 1 : 0;
    if (pos === code.length) { pos = 0; startMatrix(); }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    max-width: calc(var(--measure) + 10rem);
    margin: 0 auto;
    padding: 0.7rem var(--space-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* Logo + nav sit together on the left. */
  .left {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand .logo {
    display: block;
    border-radius: 50%;
    filter: drop-shadow(0 2px 6px color-mix(in srgb, var(--accent) 26%, transparent));
    transition: transform 0.18s ease;
  }

  .brand:hover .logo,
  .brand:focus-visible .logo {
    transform: scale(1.06);
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.3rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  nav li { margin: 0; }

  nav a {
    color: var(--fg-dim);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-left: 1.4rem;
    border-left: 1px solid var(--border);
  }

  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.32em 0.75em;
    min-height: 2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .tool.icon {
    padding: 0.32em;
    width: 2rem;
  }

  .tool:hover,
  .tool:focus-visible {
    color: var(--accent);
    border-color: var(--accent-dim);
    background: var(--glow);
  }

  .tool kbd {
    font-family: inherit;
    font-size: 0.72rem;
  }

  @media (max-width: 680px) {
    .inner { padding: 0.6rem var(--space-2); }
    .left { gap: 1rem; }
    nav ul { gap: 0.9rem; font-size: 0.8rem; }
    .tools { padding-left: 0.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand .logo { transition: none; }
    .brand:hover .logo,
    .brand:focus-visible .logo { transform: none; }
  }
</style>
