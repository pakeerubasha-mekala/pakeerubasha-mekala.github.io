---
import { profile } from '../data/profile';

// Shown when a newsletter signup link is set in the profile, and/or when `showRss` is passed.
const { showRss = false } = Astro.props;
const hasNewsletter = Boolean(profile.newsletterUrl);
---

{(hasNewsletter || showRss) && (
  <aside class="subscribe" aria-label="Subscribe">
    <p>{hasNewsletter ? 'Get new posts by email, or follow along with RSS.' : 'Follow along with RSS.'}</p>
    <p class="actions">
      {hasNewsletter && <a class="btn primary" href={profile.newsletterUrl}>Subscribe by email</a>}
      <a class="btn" href="/rss.xml">RSS feed</a>
    </p>
  </aside>
)}

<style>
  .subscribe {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .subscribe p {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .btn {
    display: inline-block;
    padding: 0.5em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn:hover,
  .btn:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn.primary {
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    border-color: transparent;
    color: var(--bg);
    font-weight: 600;
  }

  .btn.primary:hover,
  .btn.primary:focus-visible {
    color: var(--bg);
  }
</style>
