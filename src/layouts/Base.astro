---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import analytics from '../data/analytics.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: string;
  /** Structured data (schema.org) for search engines. */
  jsonLd?: Record<string, unknown>;
  /** Keep utility pages (duplicate or generated) out of search results. */
  noindex?: boolean;
}

const { title, description, ogType = 'website', image = '/og/default.png', jsonLd, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const siteTitle = 'Pakeeru Basha Mekala';
const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Runs before first paint: restore recruiter/clean mode and decide whether to play the boot sequence.
      (function () {
        try {
          var d = document.documentElement;
          if (localStorage.getItem('mode') === 'clean') d.dataset.mode = 'clean';
          var sc = localStorage.getItem('scheme');
          if (sc === 'light' || sc === 'dark') d.dataset.scheme = sc;
          var ac = localStorage.getItem('accent');
          if (ac && ac !== 'green') d.dataset.accent = ac;
          if (
            location.pathname === '/' &&
            d.dataset.mode !== 'clean' &&
            !sessionStorage.getItem('booted') &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) d.classList.add('booting');
        } catch (e) {}
      })();
    </script>
    {analytics.goatcounter && (
      <script is:inline async data-goatcounter={`https://${analytics.goatcounter}.goatcounter.com/count`} src="//gc.zgo.at/count.js"></script>
    )}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>
