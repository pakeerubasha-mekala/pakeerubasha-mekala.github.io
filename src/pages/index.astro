---
import Base from '../layouts/Base.astro';
import BootScreen from '../components/BootScreen.astro';
import Pipeline from '../components/Pipeline.astro';
import Terminal from '../components/Terminal.astro';
import Subscribe from '../components/Subscribe.astro';
import SideNav from '../components/SideNav.astro';
import AtAGlance from '../components/AtAGlance.astro';
import Icon from '../components/art/Icon.astro';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { skills } from '../data/skills';
import { projects } from '../data/projects';
import { education } from '../data/education';
import { publications } from '../data/publications';
import { offerings } from '../data/offerings';
import { testimonials } from '../data/testimonials';

const workIds = new Set((await getCollection('work')).map((w) => w.id));
// Home shows the short highlights; the full detail lives on the case-study pages and the website data.
const pick = (short?: string[], full: string[] = []) => (short && short.length > 0 ? short : full);

const caseStudy = (name?: string) => {
  const id = (name ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return workIds.has(id) ? `/work/${id}/` : null;
};

const navItems = [
  { id: 'about', label: 'about' },
  { id: 'what-i-do', label: 'what I do' },
  { id: 'experience', label: 'experience' },
  ...(testimonials.length > 0 ? [{ id: 'testimonials', label: 'testimonials' }] : []),
  { id: 'skills', label: 'skills' },
  ...(projects.length > 0 ? [{ id: 'projects', label: 'projects' }] : []),
  { id: 'education', label: 'education' },
  ...(publications.length > 0 ? [{ id: 'publications', label: 'publications' }] : []),
  { id: 'contact', label: 'contact' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline.split(' · ')[0],
  description: profile.summary,
  url: Astro.site?.href,
  image: new URL(profile.photo, Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.stackoverflow].filter(Boolean),
};

// Career started Nov 2016 (first role on LinkedIn).
const careerStart = new Date(2016, 10, 1);
const years = Math.floor((Date.now() - careerStart.getTime()) / (365.25 * 24 * 3600 * 1000));

const stats = [
  { value: `${years}+`, label: 'years in DevOps' },
  { value: '150+', label: 'microservices monitored' },
  { value: '3', label: 'clouds: AWS, GCP, Azure' },
];
---

<Base title="Pakeeru Basha Mekala" description={profile.summary} jsonLd={jsonLd}>
  <BootScreen />
  <SideNav slot="left" items={navItems} />
  <AtAGlance slot="right" />

  <section id="about" class="hero">
    <img class="avatar" src={profile.photo} alt={profile.name} width="132" height="132" />
    <div class="hero-text">
      <p class="whoami" aria-hidden="true">$ whoami</p>
      <p class="eyebrow"><span class="dot"></span>DevOps · Multi-cloud · Kubernetes</p>
      <h1 class="glitch" data-text={profile.name}>{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <p class="meta">{profile.location}</p>
    </div>
  </section>

  <p class="summary">{profile.summary}</p>

  <p class="cta">
    <a class="btn primary" href="#contact">Hire me</a>
    <a class="btn" href="/pakeeru-basha-mekala-resume.pdf" download>Download resume</a>
    {profile.bookingUrl && <a class="btn" href={profile.bookingUrl}>Book a call</a>}
  </p>

  <ul class="stats">
    {stats.map((s) => (
      <li class={s.value.length > 5 ? 'small' : ''}>
        <strong>{s.value}</strong>
        <span>{s.label}</span>
      </li>
    ))}
  </ul>

  <section id="what-i-do">
    <h2>what I do</h2>
    <div class="offers">
      {offerings.map((o) => (
        <article class="offer card">
          <div class="offer-head">
            {o.icon && <span class="offer-icon fx" aria-hidden="true"><Icon name={o.icon} /></span>}
            <h3>{o.title}</h3>
          </div>
          <p>{o.text}</p>
          {o.href && <p class="offer-link"><a href={o.href}>{o.linkLabel ?? 'learn more'} →</a></p>}
        </article>
      ))}
    </div>
    <p class="offers-more"><a href="/work">See the case studies →</a></p>
  </section>

  <Pipeline />

  <Terminal />

  <section id="experience">
    <h2>experience</h2>
    <div class="timeline">
      {experience.map((job) => (
        <article class="job card">
          <h3>{job.role} <span class="at">@ {job.company}</span></h3>
          <p class="period">{job.period}{job.location && ` · ${job.location}`}</p>
          {pick(job.resumeBullets, job.bullets).length > 0 && (
            <ul class="bullets">
              {pick(job.resumeBullets, job.bullets).map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
          {job.tech.length > 0 && (
            <ul class="tag-list">
              {job.tech.map((t) => <li>{t}</li>)}
            </ul>
          )}
          {job.projects?.map((proj) => (
            <div class="proj">
              <h4>{proj.name || proj.location}</h4>
              <p class="period">{proj.period}{proj.name && proj.location && ` · ${proj.location}`}</p>
              {caseStudy(proj.name) && <p class="period"><a href={caseStudy(proj.name)!}>read the case study →</a></p>}
              <ul class="bullets">
                {pick(proj.resumeBullets, proj.bullets).map((bullet) => <li>{bullet}</li>)}
              </ul>
              <ul class="tag-list">
                {proj.tech.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          ))}
        </article>
      ))}
    </div>
  </section>

  {testimonials.length > 0 && (
    <section id="testimonials">
      <h2>testimonials</h2>
      <div class="quotes">
        {testimonials.map((t) => (
          <figure class="quote card">
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.role}{t.company && ` · ${t.company}`}</span>
              {t.result && <em>{t.result}</em>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section id="skills">
    <h2>skills</h2>
    <div class="pods fx" role="group" aria-label="Skills">
      <div class="pod head"><span>NAME</span><span>READY</span><span>STATUS</span><span>TOOLS</span></div>
      <div class="pod live-row" id="pod-live" hidden>
        <span class="name">site-deploy</span>
        <span>1/1</span>
        <span class="run"><i></i><b class="state">Succeeded</b></span>
        <span class="tools"></span>
      </div>
      {skills.map((group) => (
        <div class="pod">
          <span class="name">{group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, '')}</span>
          <span>1/1</span>
          <span class="run"><i></i>Running</span>
          <span class="tools">{group.items.join(', ')}</span>
        </div>
      ))}
      <p class="foot">Skill rows are decorative (no cluster behind them). The <b>site-deploy</b> row is live from GitHub Actions.</p>
    </div>
    <div class="skills-grid">
      {skills.map((group) => (
        <div class="skill-group card">
          <h3>{group.label}</h3>
          <ul class="tag-list">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {projects.length > 0 && (
    <section id="projects">
      <h2>projects</h2>
      {projects.map((project) => (
        <article class="project card">
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <ul class="tag-list">
            {project.tech.map((t) => <li>{t}</li>)}
          </ul>
          {project.links && (
            <p class="project-links">
              {project.links.map((link, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          )}
        </article>
      ))}
    </section>
  )}

  <section id="education">
    <h2>education</h2>
    {education.map((item) => (
      <article class="edu card">
        <h3>{item.field}</h3>
        <p class="period">{item.degree} · {item.institution} · {item.period}{item.grade && ` · ${item.grade}`}</p>
      </article>
    ))}
  </section>

  {publications.length > 0 && (
    <section id="publications">
      <h2>publications</h2>
      {publications.map((pub) => (
        <article class="pub card">
          <h3>{pub.title}</h3>
          <p class="period">{pub.venue} · {pub.date}</p>
          <p>{pub.summary}</p>
          {pub.links && (
            <p class="project-links">
              {pub.links.map((link, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          )}
        </article>
      ))}
    </section>
  )}

  <Subscribe />

  <section id="contact">
    <h2>contact</h2>
    <div class="card contact-card">
      <p>
        {profile.email && <>Reach me at <a href={`mailto:${profile.email}`}>{profile.email}</a> or find me on </>}
        {!profile.email && <>Let's connect — find me on </>}
        <a href={profile.links.linkedin}>LinkedIn</a>.
      </p>
      <a class="btn primary" href={profile.links.linkedin}>Say hello</a>
    </div>
  </section>
</Base>

<style>
  .pods {
    padding: var(--space-2);
    background: #05080c;
    color: #d7dde3;
    border: 1px solid #1c2530;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    overflow-x: auto;
  }

  .pod {
    display: grid;
    grid-template-columns: 15rem 3.5rem 7.5rem 1fr;
    gap: 0.4rem 1rem;
    padding: 0.3rem 0;
    border-bottom: 1px dashed #17202a;
    min-width: 40rem;
  }

  .pod[hidden] { display: none; }
  .pod.live-row .name { color: #ffd479; }
  .pod.live-row.failure .run { color: #ff6b6b; }
  .pod.live-row.failure .run i { background: #ff6b6b; box-shadow: 0 0 8px #ff6b6b; }

  .pods .foot {
    margin: 0.6rem 0 0;
    font-size: 0.72rem;
    color: #8b98ab;
  }

  .pods .foot b { color: #ffd479; font-weight: 500; }
  .pod.head { color: #8b98ab; }
  .pod .name { color: #8fd1ff; }
  .pod .tools { color: #9aa6b6; }

  .run {
    color: #36f2a0;
  }

  .run i {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5ch;
    border-radius: 50%;
    background: #36f2a0;
    box-shadow: 0 0 8px #36f2a0;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% { opacity: 0.35; }
  }

  :global(html:not([data-mode="clean"])) .skills-grid {
    display: none;
  }

  :global(html:not([data-mode="clean"])) .hero-text h1.glitch {
    position: relative;
  }

  :global(html:not([data-mode="clean"])) h1.glitch::before,
  :global(html:not([data-mode="clean"])) h1.glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    background: none;
    pointer-events: none;
  }

  :global(html:not([data-mode="clean"])) h1.glitch::before {
    -webkit-text-fill-color: #5ab0ff;
  }

  :global(html:not([data-mode="clean"])) h1.glitch::after {
    -webkit-text-fill-color: #ff4d8d;
  }

  :global(html:not([data-mode="clean"])) h1.glitch:hover::before {
    opacity: 0.8;
    animation: glitch-a 0.45s steps(2) infinite;
  }

  :global(html:not([data-mode="clean"])) h1.glitch:hover::after {
    opacity: 0.8;
    animation: glitch-b 0.45s steps(2) infinite;
  }

  @keyframes glitch-a {
    0% { transform: translate(-3px, 0); clip-path: inset(0 0 60% 0); }
    100% { transform: translate(2px, 1px); clip-path: inset(40% 0 20% 0); }
  }

  @keyframes glitch-b {
    0% { transform: translate(3px, 0); clip-path: inset(55% 0 0 0); }
    100% { transform: translate(-2px, -1px); clip-path: inset(10% 0 55% 0); }
  }

  .hero {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .avatar {
    flex: none;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg);
    box-shadow:
      0 0 0 2px var(--accent),
      0 0 0 6px var(--glow),
      var(--shadow);
  }

  .hero-text h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    margin: 0.1em 0 0.15em;
    background: linear-gradient(100deg, var(--fg) 0%, var(--accent) 55%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .whoami {
    display: block;
    width: 10ch;
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-dim);
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid var(--accent);
    animation: typing 1.2s steps(10) 1, caret 0.9s steps(1) infinite;
  }

  @keyframes typing {
    from { width: 0; }
    to { width: 10ch; }
  }

  @keyframes caret {
    50% { border-color: transparent; }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    margin: 0;
    padding: 0.15em 0.7em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    background: var(--glow);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .headline {
    font-family: var(--font-mono);
    color: var(--fg);
    margin: 0 0 0.25em;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
    margin: 0;
  }

  .summary {
    font-size: 1.08rem;
    color: var(--fg-dim);
    margin-top: var(--space-3);
    max-width: 62ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: var(--space-2) 0 var(--space-3);
  }

  .btn {
    display: inline-block;
    padding: 0.5em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition: transform 0.15s, border-color 0.15s, color 0.15s;
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn.primary {
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    border-color: transparent;
    color: var(--bg);
    font-weight: 600;
  }

  .btn.primary:hover,
  .btn.primary:focus-visible {
    color: var(--bg);
    box-shadow: 0 0 0 4px var(--glow);
  }

  .cta {
    margin-bottom: var(--space-3);
  }

  .offer-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.5rem;
  }

  .offer-head h3 {
    margin: 0;
  }

  .offer-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.5rem;
    border-radius: 12px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  @media (max-width: 640px) {
    .offers {
      grid-template-columns: 1fr;
    }
  }

  .offer h3 {
    font-size: 0.98rem;
    color: var(--accent);
  }

  .offer p {
    margin: 0;
    font-size: 0.92rem;
  }

  .offers-more {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .offer .offer-link {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .quotes {
    display: grid;
    gap: var(--space-2);
  }

  .quote {
    margin: 0;
  }

  .quote blockquote {
    margin: 0 0 0.8rem;
    padding: 0;
    border: none;
    color: var(--fg);
    font-size: 1rem;
  }

  .quote figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    align-items: baseline;
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .quote figcaption strong {
    color: var(--fg);
  }

  .quote figcaption em {
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--accent);
  }

  .stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-2);
  }

  .stats li {
    margin: 0;
    padding: var(--space-2);
    text-align: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .stats strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.7rem;
    line-height: 2.2rem;
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats li.small strong {
    font-size: 1.15rem;
  }

  .stats span {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-dim);
    box-shadow: var(--shadow), 0 0 0 1px var(--glow);
  }

  .card h3 {
    margin-top: 0;
  }

  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-3);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: linear-gradient(var(--accent), var(--border));
  }

  .job {
    position: relative;
  }

  .job::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--space-3) + 0.1rem);
    top: 1.35rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .job .at {
    color: var(--fg-dim);
    font-weight: 400;
    font-size: 0.85em;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--fg-dim);
    margin: -0.3em 0 0.8em;
  }

  .proj {
    margin-top: var(--space-2);
    padding-left: var(--space-2);
    border-left: 2px solid var(--border);
  }

  .proj h4 {
    margin: 0 0 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--accent);
  }

  .proj .period {
    margin-top: 0;
  }

  .bullets {
    margin: 0 0 var(--space-1);
    font-size: 0.95rem;
  }

  .bullets li::marker {
    color: var(--accent);
  }

  .project + .project,
  .edu + .edu,
  .pub + .pub {
    margin-top: var(--space-2);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2);
  }

  .skill-group h3 {
    font-size: 0.9rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 0;
  }

  .project-links {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .contact-card p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .whoami { animation: none; }
  }

  @media (max-width: 560px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }
    .timeline {
      padding-left: var(--space-2);
    }
    .job::before {
      display: none;
    }
    .timeline::before {
      display: none;
    }
  }
</style>
