---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found.">
  <section class="not-found">
    <p class="prompt">$ kubectl get pods -n {Astro.url.pathname}</p>
    <pre>NAME                 READY   STATUS             RESTARTS   AGE
this-page-7d9f8c     0/1     CrashLoopBackOff   42         ∞

Error from server (NotFound): page "{Astro.url.pathname}" not found
Back-off restarting failed container. Nothing here to deploy.</pre>
    <p><a href="/">← kubectl rollout undo (back home)</a></p>
  </section>
</Base>

<style>
  .not-found {
    margin-top: var(--space-4);
  }

  .not-found .prompt {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  pre {
    color: #ff8a8a;
    overflow-x: auto;
  }
</style>
