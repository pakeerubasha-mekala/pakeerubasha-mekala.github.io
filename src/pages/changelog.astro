---
import { execSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';

// Changelog straight from the commit history. Needs full history in CI
// (actions/checkout with fetch-depth: 0); falls back to empty on a shallow clone.
const repoUrl = `https://github.com/${profile.repo}`;

interface Entry { sha: string; subject: string; date: string }
let entries: Entry[] = [];
try {
  const out = execSync('git log -80 --no-merges --pretty=format:%h%x1f%s%x1f%aI', { encoding: 'utf8' });
  entries = out.split('\n').filter(Boolean).map((l) => {
    const [sha, subject, date] = l.split('\x1f');
    return { sha, subject, date };
  });
} catch {}

const groups: { day: string; items: Entry[] }[] = [];
for (const e of entries) {
  const day = e.date.slice(0, 10);
  let g = groups.find((x) => x.day === day);
  if (!g) { g = { day, items: [] }; groups.push(g); }
  g.items.push(e);
}
const fmtDay = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="Changelog" description={`What's changed on ${profile.name}'s site — straight from the git history.`}>
  <h1>Changelog</h1>
  <p class="lead">What's changed on this site, straight from the commit history — rebuilt and deployed to GitHub Pages and Cloudflare on every push.</p>

  {groups.length === 0 ? (
    <p class="muted">History isn't available in this build. See <a href={repoUrl}>the repository</a>.</p>
  ) : (
    <div class="log">
      {groups.map((g) => (
        <section class="day">
          <h2>{fmtDay(g.day)}</h2>
          <ul>
            {g.items.map((e) => (
              <li>
                <a class="sha" href={`${repoUrl}/commit/${e.sha}`} rel="noopener noreferrer" target="_blank">{e.sha}</a>
                <span class="subject">{e.subject}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</Base>

<style>
  .lead { color: var(--fg-dim); max-width: 60ch; margin-bottom: var(--space-3); }
  .muted { color: var(--fg-dim); }

  .day { margin-bottom: var(--space-3); }

  .day h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-1);
  }
  .day h2::before, .day h2::after { content: none; }

  .day ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }

  .day li {
    position: relative;
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.35rem 0 0.35rem 1rem;
    margin: 0;
  }

  .day li::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.8rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent-dim);
  }

  .sha {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
  }
  .sha:hover { text-decoration: underline; }

  .subject { color: var(--fg); }
</style>
