---
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { skills } from '../data/skills';
import { education } from '../data/education';

// One-page resume. Experience uses the short `resumeBullets` when a role has them (falls back to the
// full highlights), so the website keeps the detail and the resume stays on one page.
// The plain, ATS-friendly version lives at /resume-ats.
const pdfPath = '/pakeeru-basha-mekala-resume.pdf';
const atsPdfPath = '/pakeeru-basha-mekala-resume-ats.pdf';

const siteUrl = Astro.site?.href ?? 'https://pakeerubasha-mekala.github.io/';
const qr = await QRCode.toString(siteUrl, { type: 'svg', margin: 0, color: { dark: '#0d6b4a', light: '#0000' } });
const updated = new Date().toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
const contact = [
  { label: 'email', text: profile.email, href: profile.email && `mailto:${profile.email}` },
  { label: 'linkedin', text: short(profile.links.linkedin), href: profile.links.linkedin },
  { label: 'github', text: profile.links.github && short(profile.links.github), href: profile.links.github },
  { label: 'location', text: profile.location },
].filter((c) => c.text);

const pick = (resume?: string[], full: string[] = []) => (resume && resume.length > 0 ? resume : full);
---

<Base title="Resume" description={`Resume of ${profile.name}: ${profile.headline}`}>
  <div class="actions no-print">
    <a class="btn primary" href={pdfPath} download>Download PDF</a>
    <a class="btn" href={atsPdfPath} download title="Plain single-column layout for applicant tracking systems">Download ATS-friendly PDF</a>
    <a class="btn" href="/">← back to site</a>
  </div>

  <article class="sheet">
    <aside class="side">
      <img class="photo" src={profile.photo} alt={profile.name} width="120" height="120" />
      <h1>{profile.name}</h1>
      <p class="role">{profile.headline}</p>

      <section>
        <h2>contact</h2>
        <dl class="contact">
          {contact.map((c) => (
            <>
              <dt>{c.label}</dt>
              <dd>{c.href ? <a href={c.href}>{c.text}</a> : c.text}</dd>
            </>
          ))}
        </dl>
      </section>

      <section>
        <h2>skills</h2>
        {skills.map((g) => (
          <div class="skill">
            <h3>{g.label}</h3>
            <p class="chips">{g.items.map((item) => <span>{item}</span>)}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>education</h2>
        {education.map((e) => (
          <div class="edu">
            <p class="edu-degree">{e.degree}</p>
            <p>{e.field}</p>
            <p class="muted">{e.institution}</p>
            <p class="muted">{e.period}{e.grade && ` · ${e.grade}`}</p>
          </div>
        ))}
      </section>

    </aside>

    <div class="main">
      <section>
        <h2>summary</h2>
        <p class="summary">{profile.summary}</p>
      </section>

      <section>
        <h2>experience</h2>
        <div class="timeline">
          {experience.map((job) => (
            <div class="job">
              <div class="job-head">
                <h3>{job.role}</h3>
                <span class="period">{job.period}</span>
              </div>
              <p class="org">{job.company}{job.location && ` · ${job.location}`}</p>
              {pick(job.resumeBullets, job.bullets).length > 0 && (
                <ul>{pick(job.resumeBullets, job.bullets).map((b) => <li>{b}</li>)}</ul>
              )}
              {job.tech.length > 0 && <p class="stack">{job.tech.join(' · ')}</p>}

              {job.projects?.map((proj) => (
                <div class="proj">
                  <div class="job-head">
                    <h4>{proj.name || proj.location}</h4>
                    <span class="period">{proj.period}</span>
                  </div>
                  {proj.name && proj.location && <p class="org">{proj.location}</p>}
                  <ul>{pick(proj.resumeBullets, proj.bullets).map((b) => <li>{b}</li>)}</ul>
                  {proj.tech.length > 0 && <p class="stack">{proj.tech.join(' · ')}</p>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>

      <footer class="foot">
        <a class="qr" href={siteUrl}>
          <span class="qr-code" aria-hidden="true" set:html={qr} />
          <span class="qr-label">scan for my portfolio<br />{siteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
        </a>
        <p class="updated">Updated {updated}</p>
      </footer>
    </div>
  </article>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: var(--space-2) 0;
  }

  .btn {
    display: inline-block;
    padding: 0.5em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .btn.primary {
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    border-color: transparent;
    color: var(--bg);
    font-weight: 600;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url('/fonts/inter-latin-400-normal.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 500;
    font-display: block;
    src: url('/fonts/inter-latin-500-normal.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 600;
    font-display: block;
    src: url('/fonts/inter-latin-600-normal.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 700;
    font-display: block;
    src: url('/fonts/inter-latin-700-normal.woff2') format('woff2');
  }

  /* The sheet looks the same on screen and in the PDF: a dark terminal-style sidebar beside a white page. */
  .sheet {
    --r-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    --r-mono: var(--r-sans); /* one typeface throughout; kept as a variable so a second face is easy to reintroduce */
    --ink: #1c2430;
    --muted: #5b6676;
    --line: #dde3ea;
    --brand: #0d6b4a;
    --neon: #36f2a0;
    --side: #0b1220;
    --side-ink: #d7dde3;
    --side-muted: #8a97ab;

    display: grid;
    grid-template-columns: 17.5rem 1fr;
    background: #fff;
    color: var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    font-family: var(--r-sans);
    font-size: 0.9rem;
    line-height: 1.45;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sheet :global(*) {
    color: inherit;
  }

  .sheet h1,
  .sheet h2,
  .sheet h3,
  .sheet h4 {
    font-family: var(--r-sans);
  }

  .sheet h2::before,
  .sheet h2::after {
    content: none;
  }

  /* ---- sidebar ---- */
  .side {
    padding: 1.7rem 1.3rem 1.4rem;
    background:
      radial-gradient(18rem 12rem at 0% 0%, rgba(54, 242, 160, 0.18), transparent 70%),
      var(--side);
    color: var(--side-ink);
  }

  .photo {
    display: block;
    width: 108px;
    height: 108px;
    margin: 0 auto 0.9rem;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--side);
    box-shadow: 0 0 0 2px var(--neon), 0 0 22px rgba(54, 242, 160, 0.35);
  }

  .side h1 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.15;
    color: #fff;
  }

  .role {
    margin: 0.35rem 0 0.8rem;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--neon);
  }

  .side section {
    margin-top: 0.85rem;
  }

  .side h2 {
    display: block;
    margin: 0 0 0.45rem;
    padding: 0;
    font-family: var(--r-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--neon);
    border: none;
  }

  .contact {
    display: grid;
    gap: 0.28rem;
    margin: 0;
  }

  .contact dt {
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--side-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .contact dd {
    margin: 0 0 0.2rem;
    font-size: 0.78rem;
    word-break: break-word;
  }

  .contact a {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgba(54, 242, 160, 0.55);
    text-underline-offset: 2px;
  }

  .skill {
    margin-bottom: 0.4rem;
  }

  .skill h3 {
    margin: 0 0 0.2rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--side-ink);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.22rem;
    margin: 0;
  }

  .chips span {
    padding: 0.05rem 0.5rem;
    font-size: 0.66rem;
    font-weight: 500;
    color: var(--neon);
    background: rgba(54, 242, 160, 0.09);
    border: 1px solid rgba(54, 242, 160, 0.32);
    border-radius: 999px;
  }

  .edu p {
    margin: 0;
    font-size: 0.76rem;
  }

  .edu-degree {
    font-weight: 600;
    color: #fff;
  }

  .muted {
    color: var(--side-muted);
  }

  .qr {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .qr-code {
    display: block;
    width: 64px;
    height: 64px;
    flex: none;
  }

  .qr-code :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .qr-label {
    font-size: 0.68rem;
    line-height: 1.4;
    color: var(--muted);
  }

  /* ---- main column ---- */
  .main {
    display: flex;
    flex-direction: column;
    padding: 1.7rem 1.8rem 1.4rem;
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .main h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    padding: 0;
    font-family: var(--r-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
    break-after: avoid;
  }

  .main h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
    margin: 0;
  }

  .main section + section {
    margin-top: 1.1rem;
  }

  .summary {
    margin: 0;
  }

  .timeline {
    position: relative;
    padding-left: 1rem;
    border-left: 2px solid var(--line);
  }

  .job {
    position: relative;
    margin-bottom: 0.9rem;
  }

  .job::before {
    content: '';
    position: absolute;
    left: calc(-1rem - 6px);
    top: 0.3rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--brand);
  }

  .job:last-child {
    margin-bottom: 0;
  }

  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    break-after: avoid;
  }

  .main h3 {
    margin: 0;
    font-size: 0.98rem;
    color: var(--ink);
  }

  .main h4 {
    margin: 0;
    font-size: 0.88rem;
    color: var(--brand);
  }

  .period {
    flex: none;
    font-size: 0.78rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
  }

  .org {
    margin: 0.05rem 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brand);
    break-after: avoid;
  }

  .main ul {
    margin: 0 0 0.3rem;
    padding-left: 1rem;
  }

  .main li {
    margin-bottom: 0.18rem;
    break-inside: avoid;
  }

  .main li::marker {
    color: var(--brand);
  }

  .stack {
    margin: 0 0 0.2rem;
    font-size: 0.74rem;
    color: var(--muted);
  }

  .proj {
    margin-top: 0.55rem;
    padding-left: 0.7rem;
    border-left: 2px solid var(--line);
  }

  .updated {
    margin: 0;
    font-size: 0.7rem;
    text-align: right;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .sheet {
      grid-template-columns: 1fr;
    }
    .job-head {
      flex-direction: column;
      gap: 0;
    }
  }

  @media print {
    .sheet {
      border-radius: 0;
      box-shadow: none;
      grid-template-columns: 65mm 1fr;
      min-height: 266mm;
      font-size: 8.7pt;
      line-height: 1.36;
    }
    .side {
      padding: 7mm 5mm 5mm;
    }
    .skill {
      margin-bottom: 0.3rem;
    }
    .chips span {
      font-size: 0.64rem;
    }
    .contact dd {
      margin-bottom: 0.1rem;
    }
    .main {
      padding: 7mm 7mm 4mm 7mm;
    }
    .foot {
      padding-top: 0.4rem;
    }
    .job {
      margin-bottom: 0.65rem;
    }
    .proj {
      margin-top: 0.4rem;
    }
    .main section + section {
      margin-top: 0.85rem;
    }
    .photo {
      width: 23mm;
      height: 23mm;
      margin-bottom: 0.6rem;
    }
    .side h1 {
      font-size: 13.5pt;
    }
    .qr-code {
      width: 15mm;
      height: 15mm;
    }
    .job-head {
      flex-direction: row;
    }
  }
</style>
