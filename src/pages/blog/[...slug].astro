---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { readingTime } from '../../utils/readingTime';
import Comments from '../../components/Comments.astro';
import SideNav from '../../components/SideNav.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Table of contents from h2/h3 headings (only worth showing on longer posts).
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Related posts: other published posts sharing the most tags.
const all = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ post: p, shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
  .filter((r) => r.shared > 0)
  .sort((a, b) => b.shared - a.shared || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((r) => r.post);

const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const editUrl = `https://github.com/${profile.repo}/edit/main/src/content/blog/${post.id}.md`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: profile.name, url: profile.links.linkedin },
};

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={post.data.title} description={post.data.description} ogType="article" jsonLd={jsonLd} image={`/og/post-${post.id}.png`}>
  {toc.length >= 3 && <SideNav slot="left" title="on this page" items={toc.map((h) => ({ id: h.slug, label: h.text, depth: h.depth }))} />}
  <AtAGlance slot="right" />
  <div class="progress no-print" aria-hidden="true"><div id="progress-bar"></div></div>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <span>{dateFmt(post.data.pubDate)}</span>
        {post.data.updatedDate && <span>· updated {dateFmt(post.data.updatedDate)}</span>}
        <span>· {readingTime(post.body)} min read</span>
        {post.data.draft && <span>· draft</span>}
      </p>
      {post.data.canonicalUrl && (
        <p class="post-meta">Also published on <a href={post.data.canonicalUrl}>{new URL(post.data.canonicalUrl).hostname.replace('www.', '')}</a></p>
      )}
      {post.data.tags.length > 0 && (
        <ul class="tag-list">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    {toc.length >= 3 && (
      <nav class="toc" aria-label="Table of contents">
        <p class="toc-title">on this page</p>
        <ol>
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'sub' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose">
      <Content />
    </div>
    <p class="post-footer">
      <a href="/blog">← back to blog</a>
      <a href={editUrl} rel="noopener noreferrer" target="_blank">edit on GitHub</a>
    </p>
    {related.length > 0 && (
      <section class="related" aria-label="Related posts">
        <h2>related</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/blog/${r.id}/`}>{r.data.title}</a>
              <span>{r.data.tags.filter((t) => post.data.tags.includes(t)).map((t) => `#${t}`).join(' ')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <Comments />
  </article>
</Base>

<script>
  // Reading progress bar along the top of the page.
  const bar = document.getElementById('progress-bar');
  if (bar) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // Add a "copy" button to every code block in the post.
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;
    pre.classList.add('has-copy');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        btn.textContent = 'copied';
      } catch {
        btn.textContent = 'press Ctrl+C';
      }
      setTimeout(() => { btn.textContent = 'copy'; }, 1600);
    });
    pre.appendChild(btn);
  });
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 20;
    background: transparent;
  }

  #progress-bar {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .post-header {
    margin-bottom: var(--space-3);
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .prose :global(h2) {
    margin-top: var(--space-3);
  }

  .prose :global(a) {
    word-break: break-word;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* The table of contents moves into the left rail on wide screens. */
  @media (min-width: 1400px) {
    .toc {
      display: none;
    }
  }

  .toc {
    margin: 0 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }

  .toc-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .toc ol {
    margin: 0;
    padding-left: 1.2rem;
  }

  .toc li {
    margin-bottom: 0.2rem;
  }

  .toc li.sub {
    margin-left: 1rem;
    list-style: circle;
  }

  .prose :global(pre.has-copy) {
    position: relative;
  }

  .prose :global(.copy) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.15em 0.6em;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    opacity: 0.75;
  }

  .prose :global(.copy:hover),
  .prose :global(.copy:focus-visible) {
    opacity: 1;
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  .related ul {
    list-style: none;
    padding: 0;
  }

  .related li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .related span {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-dim);
  }
</style>
